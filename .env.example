# .env.example — Required and optional environment variables for ROTAS
# Copy to backend/.env for local development. For Railway/Vercel, set as platform env vars.

# ============================================================
# REQUIRED — App will not start without these
# ============================================================

# Environment name. Controls strict mode (CORS, Secure cookies, test-token bypass).
# Values: development | test | production
ENVIRONMENT=development

# HMAC-SHA256 secret for JWT signing. Must be at least 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# NEVER commit the actual secret. Railway: set as a Railway environment variable.
JWT_SECRET_KEY=change-me-locally

# PostgreSQL connection URL. NOTE: use postgresql+asyncpg:// scheme — NOT postgresql://
# Railway PostgreSQL add-on provides a URL — rewrite the scheme before setting it.
# Example: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://rotas:rotas@localhost:55432/rotas

# ============================================================
# REQUIRED IN PRODUCTION (ENVIRONMENT=production)
# ============================================================

# JSON list of allowed CORS origins. Must be explicit URLs — no wildcards.
# Example: ["https://rotas-manager.vercel.app"]
# pydantic-settings parses JSON list from env var automatically.
CORS_ORIGINS=["http://localhost:3030","http://localhost:5174"]

# ============================================================
# VERCEL — Manager frontend env vars (set in Vercel project settings)
# ============================================================

# Backend Railway public URL. NEXT_PUBLIC_ prefix required for Next.js browser exposure.
# NEXT_PUBLIC_API_URL=https://YOUR-RAILWAY-APP.up.railway.app

# ============================================================
# DRIVER PWA — Local demo defaults
# ============================================================

VITE_ROTAS_API_BASE_URL=http://localhost:8000
VITE_ROTAS_TENANT_ID=
VITE_ROTAS_VEHICLE_ID=
VITE_ROTAS_DRIVER_ID=
VITE_ROTAS_CHECKLIST_TEMPLATE_ID=
VITE_ROTAS_DRIVER_TOKEN=dev-token

# ============================================================
# OPTIONAL — App starts with defaults if absent
# ============================================================

# Local file upload directory (default: .rotas_uploads)
LOCAL_UPLOAD_DIR=.rotas_uploads

# Redis URL (required for KPI caching in Phase 3 — unused in Phase 1)
# REDIS_URL=redis://localhost:6381/0

# Future integrations
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
MPESA_API_KEY=
EMOLA_API_KEY=
