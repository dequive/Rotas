{
  "name": "@rotas/driver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "generate-icons": "node scripts/generate-icons.mjs",
    "prebuild": "node scripts/generate-icons.mjs",
    "build": "tsc && vite build --config vite.config.ts --configLoader native",
    "preview": "vite preview --config vite.config.ts --configLoader native",
    "e2e": "playwright test --config playwright.config.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude e2e/**"
  },
  "dependencies": {
    "@rotas/http-contract": "0.1.0",
    "@sentry/browser": "^8.55.2",
    "dexie": "^4.0.0",
    "lucide-react": "^0.468.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "workbox-background-sync": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@sentry/vite-plugin": "5.4.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.0",
    "vite": "7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
