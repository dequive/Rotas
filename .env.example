# .env.example — Required and optional environment variables for ROTAS
# Copy to backend/.env for local development. For Railway/Vercel, set as platform env vars.

# ============================================================
# REQUIRED — App will not start without these
# ============================================================

# Environment name. Controls strict mode (CORS, Secure cookies, test-token bypass).
# Values: development | test | production
ENVIRONMENT=development

# HMAC-SHA256 secret for JWT signing. Must be at least 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# NEVER commit the actual secret. Railway: set as a Railway environment variable.
JWT_SECRET_KEY=change-me-locally

# =============================================================================
# DATABASE -- Three URLs required for RLS role separation (Phase 9)
# =============================================================================

# APPLICATION URL -- rotas_app role (subject to RLS enforcement).
# After Phase 9 migration: update to use rotas_app credentials.
# Local dev: postgresql+asyncpg://rotas:rotas@localhost:55432/rotas (superuser, BYPASSRLS)
# Production: postgresql+asyncpg://rotas_app:<password>@<railway-host>:<port>/railway
DATABASE_URL=postgresql+asyncpg://rotas:rotas@localhost:55432/rotas

# ALEMBIC URL -- rotas_admin role (BYPASSRLS). Required for Alembic migrations.
# CRITICAL: Must be set in Railway BEFORE deploying the RLS migration commit.
# If not set, falls back to DATABASE_URL (safe for local dev; UNSAFE in production after RLS).
# Local dev: leave empty (falls back to DATABASE_URL, superuser = BYPASSRLS)
# Production: postgresql+psycopg://rotas_admin:<password>@<railway-host>:<port>/railway
ALEMBIC_DATABASE_URL=

# ADMIN URL -- rotas_admin role (BYPASSRLS). Used by ARQ worker for cross-tenant jobs.
# If not set, falls back to DATABASE_URL (safe for local dev; UNSAFE in production after RLS).
# Local dev: leave empty (falls back to DATABASE_URL)
# Production: postgresql+asyncpg://rotas_admin:<password>@<railway-host>:<port>/railway
ADMIN_DATABASE_URL=

# =============================================================================
# RAILWAY DEPLOYMENT ORDER FOR RLS (Phase 9) -- READ BEFORE DEPLOYING
# =============================================================================
# 1. Run: alembic upgrade head (creates rotas_app + rotas_admin roles)
# 2. In Railway Query tab: ALTER ROLE rotas_app PASSWORD '...'; ALTER ROLE rotas_admin PASSWORD '...';
# 3. Set ALEMBIC_DATABASE_URL=postgresql+psycopg://rotas_admin:<pwd>@<host>/<db> in Railway vars
# 4. Set ADMIN_DATABASE_URL=postgresql+asyncpg://rotas_admin:<pwd>@<host>/<db> in Railway vars
# 5. Optionally: Update DATABASE_URL to use rotas_app role for maximum RLS enforcement
#    (leave as superuser URL if you want BYPASSRLS for the app -- RLS will still work
#     because policy is enforced based on SET LOCAL, not role; but rotas_app ensures defense-in-depth)

# ============================================================
# REQUIRED IN PRODUCTION (ENVIRONMENT=production)
# ============================================================

# JSON list of allowed CORS origins. Must be explicit URLs — no wildcards.
# Example: ["https://rotas-manager.vercel.app"]
# pydantic-settings parses JSON list from env var automatically.
CORS_ORIGINS=["http://localhost:3030","http://localhost:5174"]

# Production Redis URL. Must not point to localhost when ENVIRONMENT=production.
REDIS_URL=redis://localhost:6381

# Durable object storage is mandatory when ENVIRONMENT=production.
STORAGE_PROVIDER=local
R2_BUCKET=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Transactional email is mandatory for public self-service production.
# EMAIL_PROVIDER values: none | outbox | smtp
MANAGER_PUBLIC_URL=http://localhost:3000
EMAIL_PROVIDER=none
EMAIL_FROM_ADDRESS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ============================================================
# VERCEL — Manager frontend env vars (set in Vercel project settings)
# ============================================================

# Backend Railway public URL. NEXT_PUBLIC_ prefix required for Next.js browser exposure.
# NEXT_PUBLIC_API_URL=https://YOUR-RAILWAY-APP.up.railway.app
# Server-side API URL used by Next.js route handlers.
# ROTAS_API_BASE_URL=https://YOUR-RAILWAY-APP.up.railway.app
# Keep demo fallback disabled in public production. Set to 1 only for local demos/CI builds.
ROTAS_DISABLE_DEMO_FALLBACK=1

# ============================================================
# DRIVER PWA — Local demo defaults
# ============================================================

VITE_ROTAS_API_BASE_URL=http://localhost:8000
VITE_ROTAS_TENANT_ID=
VITE_ROTAS_VEHICLE_ID=
VITE_ROTAS_DRIVER_ID=
VITE_ROTAS_CHECKLIST_TEMPLATE_ID=
VITE_ROTAS_DRIVER_TOKEN=dev-token

# ============================================================
# OPTIONAL — App starts with defaults if absent
# ============================================================

# Local file upload directory (default: .rotas_uploads)
LOCAL_UPLOAD_DIR=.rotas_uploads

# Future integrations
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
MPESA_API_KEY=
EMOLA_API_KEY=
