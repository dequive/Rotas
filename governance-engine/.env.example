# ── Database ──────────────────────────────────────────────────────────────────
# asyncpg driver; governance_app role must exist (see infra/postgres-init.sql)
GOVERNANCE_DATABASE_URL=postgresql+asyncpg://governance_app:governance@localhost:55433/governance

# ── Runtime ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development   # development | production

# ── Security ─────────────────────────────────────────────────────────────────
# Change in production — used for JWT signing if JWT auth is ever added
JWT_SECRET_KEY=change-me-in-env

# ── CORS ─────────────────────────────────────────────────────────────────────
# JSON array of allowed origins — required to be explicit in production
# CORS_ORIGINS=["https://app.example.com"]

# ── ROTAS integration (set in ROTAS .env, not here) ──────────────────────────
# These are consumed by the ROTAS backend, not the governance engine itself:
# GOVERNANCE_ENGINE_URL=http://localhost:8001
# GOVERNANCE_API_KEY=gvn1_<prefix>_<secret>
