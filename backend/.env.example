# ROTAS Backend — Environment Variables Reference
# Copy this file to .env and fill in real values for local development.
# NEVER commit .env to version control.

# =========================================================
# Core / Required
# =========================================================

# Application environment — controls CORS strictness, pool sizing, and Redis validation
# Values: development | production
ENVIRONMENT=development
PERFORMANCE_DIAGNOSTICS=false

# PostgreSQL application connection (RLS-enforced rotas_app role)
DATABASE_URL=postgresql+asyncpg://rotas_app:rotas_app_dev@localhost:55432/rotas

# Administrative connections are intentionally separate from the API.
ALEMBIC_DATABASE_URL=postgresql+psycopg://rotas_admin:rotas_admin_dev@localhost:55432/rotas
ADMIN_DATABASE_URL=postgresql+asyncpg://rotas_admin:rotas_admin_dev@localhost:55432/rotas

# JWT signing secret — minimum 32 characters; generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production-minimum-32-chars

# =========================================================
# CORS
# =========================================================

# JSON array of allowed origins. Required in production (no wildcard).
# Example: ["https://rotas.vercel.app"]
# Local dev defaults in code: ["http://localhost:3000", "http://localhost:5173"]
CORS_ORIGINS=[]

# Optional local/test bearer token bypass. Leave empty unless explicitly needed.
DEV_TEST_TOKEN=

# =========================================================
# File Storage
# =========================================================

# Local directory for file uploads (relative to backend/)
LOCAL_UPLOAD_DIR=.rotas_uploads

# Storage provider. Production must use r2 with all R2_* settings below.
STORAGE_PROVIDER=local
R2_BUCKET=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# =========================================================
# Public URLs / Transactional Email
# =========================================================

# Public Manager URL used in password-reset and onboarding emails.
# Production must be HTTPS.
MANAGER_PUBLIC_URL=http://localhost:3000

# Values: none | outbox | smtp
# none: local/dev only, messages remain queued for inspection
# outbox: production external worker/bridge drains notification_outbox
# smtp: built-in ARQ worker sends via SMTP settings below
EMAIL_PROVIDER=none
EMAIL_FROM_ADDRESS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# =========================================================
# Redis / ARQ Job Queue
# =========================================================

# Full Redis URL (used by ARQ worker and cache layer)
# Local dev: redis://localhost:6381
# Railway: use internal Railway Redis URL
REDIS_URL=redis://localhost:6381

# Audit log retention in days. Set 0 to disable pruning.
AUDIT_LOG_RETENTION_DAYS=365

# Redis host for ARQ job queue
# Local dev: localhost
# Railway: use internal Railway Redis hostname
REDIS_HOST=localhost

# Redis port for ARQ job queue (default: 6381 per infra/docker-compose.yml)
REDIS_PORT=6381
