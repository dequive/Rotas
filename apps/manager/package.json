{
  "name": "@rotas/manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3030",
    "build": "next build && node scripts/prune-unused-image-optimizer.mjs",
    "start": "next start --port 3030",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "generate:api-types": "openapi-typescript ../../backend/openapi/rotas-v1.json --alphabetize -o app/generated/rotas-api.ts",
    "check:api-types": "openapi-typescript ../../backend/openapi/rotas-v1.json --alphabetize --check -o app/generated/rotas-api.ts",
    "test": "vitest run",
    "test:bff-boundary": "node --test scripts/verify-bff-boundary.node-test.mjs",
    "verify:bff": "node scripts/verify-bff-boundary.mjs",
    "test:no-demo": "node --test scripts/verify-no-demo-fallback.node-test.mjs",
    "verify:no-demo": "node scripts/verify-no-demo-fallback.mjs",
    "test:design-system": "node --test scripts/verify-design-system.node-test.mjs",
    "verify:design-system": "node scripts/verify-design-system.mjs",
    "test:accessibility": "node --test scripts/verify-accessibility.node-test.mjs",
    "verify:accessibility": "node scripts/verify-accessibility.mjs",
    "test:api-contracts": "node --test scripts/verify-api-contracts.node-test.mjs",
    "audit:api-contracts": "node scripts/verify-api-contracts.mjs --report",
    "verify:api-contracts": "node scripts/verify-api-contracts.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@rotas/http-contract": "0.1.0",
    "@sentry/nextjs": "^10.67.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.468.0",
    "next": "16.2.12",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "openapi-typescript": "^7.13.0",
    "postcss": "8.5.25",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.0",
    "vitest": "^4.1.9"
  },
  "optionalDependencies": {
    "@next/swc-linux-x64-gnu": "16.2.12"
  },
  "engines": {
    "node": "20.x"
  }
}
