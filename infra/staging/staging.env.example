# Non-secret staging deployment inputs.
# Copy outside the repository, replace every example.invalid reference with the
# registry digest produced after push, then run validate_staging_manifest.py.

ROTAS_RELEASE_SHA=0000000000000000000000000000000000000000
ROTAS_BACKEND_IMAGE=registry.example.invalid/rotas/backend@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
ROTAS_GOVERNANCE_IMAGE=registry.example.invalid/rotas/governance@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
ROTAS_MANAGER_IMAGE=registry.example.invalid/rotas/manager@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
ROTAS_DRIVER_IMAGE=registry.example.invalid/rotas/driver@sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd

ROTAS_MANAGER_HOST=manager.staging.example.invalid
ROTAS_DRIVER_HOST=driver.staging.example.invalid
ROTAS_API_HOST=api.staging.example.invalid
ROTAS_GOVERNANCE_TENANT_ID=11111111-1111-4111-8111-111111111111
ROTAS_GRAFANA_HOST=observability.staging.example.invalid
ACME_EMAIL=operations@example.invalid

STAGING_SECRETS_DIR=./secrets
R2_BUCKET=rotas-staging
R2_ENDPOINT_URL=https://account-id.r2.cloudflarestorage.com
EMAIL_FROM_ADDRESS=staging@example.invalid
